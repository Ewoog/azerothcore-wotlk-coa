+
+    // Addon-driven profession learn/unlearn (GETPROFS / SETPROF). CoA does not cap primary
+    // professions: a character may hold every profession at once, including Woodcutting and
+    // Woodworking. LearnProfession teaches the trainer rank spells up to the level cap
+    // (level*6, max 450) and sets the starting skill from CoaBots.Prof.StartSkill (0 = the
+    // cap, so gathering of that tier works immediately). UnlearnProfession wipes the skill
+    // and those rank spells. Tokens: ok, combat, trade, dead, teleport, invalid, unknown, missing.
+    struct ProfessionInfo
+    {
+        uint32 skillId;
+        char const* name;
+        bool secondary;
+    };
+    ProfessionInfo const* ProfessionCatalog(uint32& count);
+    uint16 ProfessionCapForLevel(uint8 level);
+    char const* LearnProfession(Player* bot, uint32 skillId);
+    char const* UnlearnProfession(Player* bot, uint32 skillId);
 }
 
