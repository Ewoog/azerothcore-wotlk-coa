 module/src/BotAddonChat.cpp              |  92 +++++++++++++
 module/src/BotMgr.cpp                    |  98 +++++++++++++-
 module/src/BotMgr.h                      |   5 +
 module/src/BotProgression.cpp            | 159 +++++++++++++++++++++++
 module/src/BotProgression.h              |  18 +++
 6 files changed, 378 insertions(+), 4 deletions(-)

diff --git a/module/conf/mod_coa_playerbots.conf.dist b/module/conf/mod_coa_playerbots.conf.dist
index 71c0d19..42c7412 100644
--- a/module/conf/mod_coa_playerbots.conf.dist
+++ b/module/conf/mod_coa_playerbots.conf.dist
@@ -352,6 +352,16 @@ CoaBots.Quest.ShareAccept = 1
 CoaBots.Gather.WhileFollowing = 1
 CoaBots.Gather.FollowRadius = 20
 
+#
+#    CoaBots.Prof.StartSkill
+#        Starting skill value when the addon teaches a bot a profession (SETPROF).
+#        0 (default) is level-based: the value is set to the level cap (level * 6,
+#        max 450) so gathering and crafting of that tier work immediately.
+#        Any other number is used as the starting value, clamped between 1 and the cap.
+#        Unlearning a profession always wipes its skill and trainer rank spells.
+#
+CoaBots.Prof.StartSkill = 0
+
 #
 #    CoaBots.MarkSessionsAsBots
 #        Description: Mark companion sessions as bots, so the server skips per-client work they have no client for
