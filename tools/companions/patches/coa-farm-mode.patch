From 80121466df225e20c09cf5c327e666d5c518d642 Mon Sep 17 00:00:00 2001
From: Ewoog <Ewoog@users.noreply.github.com>
Date: Thu, 19 Nov 2026 16:26:42 -0600
Subject: [PATCH 3/3] Farm mode: ignore group fights far from the farm

A grouped farming bot no longer runs off to a groupmate's fight
unless that fight is within the farm radius (+10 yd) of the anchor.
---
 module/src/BotAI.cpp | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/module/src/BotAI.cpp b/module/src/BotAI.cpp
index c863222..0c81114 100644
--- a/module/src/BotAI.cpp
+++ b/module/src/BotAI.cpp
@@ -4195,7 +4195,13 @@ void UpdateOffensive(Player* bot, uint32 diff, BotRole combatRole, BotRole profi
     // below both still apply, since Stay is about not *initiating*, not about refusing to
     // fight at all.
     if (!target && state.manualCommand != BotManualCommand::Stay)
+    {
         target = FindGroupCombatTarget(bot, bot->GetGroup());
+        // A farming bot joins group fights at its farm, not ones across the zone.
+        if (target && state.farmActive && (target->GetMapId() != state.farmMapId ||
+            target->GetDistance(state.farmAnchorX, state.farmAnchorY, state.farmAnchorZ) > state.farmRadius + 10.0f))
+            target = nullptr;
+    }
 
     if (!target && bot->InBattleground())
         target = BotBattlegroundAI::FindHostilePvPTarget(bot, 40.0f);
-- 
