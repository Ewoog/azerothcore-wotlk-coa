+    char const* ManualCommandName(BotManualCommand command)
+    {
+        switch (command)
+        {
+            case BotManualCommand::Stay:   return "Stay";
+            case BotManualCommand::Follow: return "Follow";
+            case BotManualCommand::None:   return "none";
+            default:                       return "Pull";
