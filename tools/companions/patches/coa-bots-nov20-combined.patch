+void ResetIdleWatch(Player* bot, BotAIState& state, uint32 now)
+{
+    state.idleMapId = bot->GetMapId();
+    state.idleAnchorX = bot->GetPositionX();
+    state.idleAnchorY = bot->GetPositionY();
+    state.idleSinceMs = now;
