--- a/module/src/BotAddonChat.cpp
+++ b/module/src/BotAddonChat.cpp
@@ -544,6 +544,90 @@ void HandleCoaBotMessage(Player* commander, std::string const& body)
 
         SendCoaBotReply(commander, "GEARPREFS:" + std::to_string(botGuidLow) + ":" + legalArmor + ":" + legalWeapon +
