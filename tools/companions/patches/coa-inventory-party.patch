From cf263b8cf6b0a9a4b3206394d96dc54f09c9daa3 Mon Sep 17 00:00:00 2001
From: Brendan Juno <brendan@localhost>
Date: Thu, 19 Nov 2026 21:11:20 -0600
Subject: [PATCH 4/4] Gather herb and ore nodes while following a player

Grouped bots that are following a real player will walk to a nearby
herbalism or mining node they can actually open, cast the real gather
spell, loot it, and resume following. Farm mode, group combat, Stay,
and a leader more than 40 yards away all skip this. Reuses the existing
solo-gather lock and skill checks.
---
 module/conf/mod_coa_playerbots.conf.dist |  24 ++++
 module/src/BotAI.cpp                     | 169 ++++++++++++++++++++++-
 module/src/BotMgr.cpp                    |   7 +
 module/src/BotMgr.h                      |   4 +
 4 files changed, 203 insertions(+), 1 deletion(-)

diff --git a/module/conf/mod_coa_playerbots.conf.dist b/module/conf/mod_coa_playerbots.conf.dist
index 18a8309..71c0d19 100644
--- a/module/conf/mod_coa_playerbots.conf.dist
+++ b/module/conf/mod_coa_playerbots.conf.dist
@@ -328,6 +328,30 @@ CoaBots.Inventory.KeepQuality = 3
 CoaBots.Quest.ShareTurnIn = 1
 CoaBots.Quest.ShareAccept = 1
 
+#
+# GATHERING WHILE FOLLOWING
+#
+#    CoaBots.Gather.WhileFollowing
+#        Description: When a bot is following a real player, it will opportunistically gather
+#                     herbalism and mining nodes it passes if it has the matching profession
+#                     and enough skill for the node (the same lock/skill check a player uses).
+#                     The bot must be out of combat, nobody in the group may be in combat, the
+#                     leader must be within 40 yards, and the bot must have bag space. It walks
+#                     to the node, casts the real gather spell (skill-ups apply normally), loots,
+#                     then resumes following. Farm mode skips this so a farm order is not
+#                     interrupted. Chests, lockboxes and skinnable corpses are not gathered.
+#                     0 turns this off.
+#        Default:     1
+#
+#    CoaBots.Gather.FollowRadius
+#        Description: How close a node must be (yards) for a following bot to notice it.
+#                     Clamped to 5-40.
+#        Default:     20
+#
+
+CoaBots.Gather.WhileFollowing = 1
+CoaBots.Gather.FollowRadius = 20
+
 #
 #    CoaBots.MarkSessionsAsBots
 #        Description: Mark companion sessions as bots, so the server skips per-client work they have no client for
diff --git a/module/src/BotAI.cpp b/module/src/BotAI.cpp
index 5232df5..b6ffa3f 100644
--- a/module/src/BotAI.cpp
+++ b/module/src/BotAI.cpp
@@ -427,6 +427,13 @@ constexpr uint32 GATHER_NODE_RETRY_MS = 60000;
 // the arrival test simply never becomes true.
 constexpr uint32 GATHER_WALK_TIMEOUT_MS = 20000;
 
+// Opportunistic herb/ore gathering while following a real player. Shorter than the solo
+// walk budget: the bot should not wander off the group for long. Scan more often than
+// idle solo gathering because the window for passing a node is brief.
+constexpr uint32 FOLLOW_GATHER_WALK_TIMEOUT_MS = 8000;
+constexpr uint32 FOLLOW_GATHER_SCAN_INTERVAL_MS = 2500;
+constexpr float FOLLOW_GATHER_LEADER_RANGE = 40.0f;
+
 // How long a targeted guild-gather order tolerates finding zero matching nodes nearby before
 // asking BotMgr to resolve and teleport to a fresh location for the same item. Node respawn
 // timers and other bots/players competing for the same resource both mean "nothing here right
@@ -2865,6 +2872,30 @@ void SetGatherNodeRetryCooldown(BotAIState& state, ObjectGuid nodeGuid)
     state.gatherNodeRetryAtMs[nodeGuid] = nowMs + GATHER_NODE_RETRY_MS;
 }
 
+// One bot at a time per node, shared by solo gathering and gather-while-following, so two
+// grouped companions do not walk to the same herb. Key is the node's guid, value is the
+// claiming bot. Released when the gather finishes, is abandoned, or the bot is Forgotten.
+std::unordered_map<ObjectGuid, ObjectGuid> claimedGatherNodes;
+
+bool IsGatherNodeClaimedByOther(ObjectGuid nodeGuid, ObjectGuid botGuid)
+{
+    auto itr = claimedGatherNodes.find(nodeGuid);
+    return itr != claimedGatherNodes.end() && itr->second != botGuid;
+}
+
+void ClaimGatherNode(ObjectGuid nodeGuid, ObjectGuid botGuid)
+{
+    for (auto itr = claimedGatherNodes.begin(); itr != claimedGatherNodes.end();)
+        itr = (itr->second == botGuid) ? claimedGatherNodes.erase(itr) : std::next(itr);
+    claimedGatherNodes[nodeGuid] = botGuid;
+}
+
+void ReleaseGatherClaim(ObjectGuid botGuid)
+{
+    for (auto itr = claimedGatherNodes.begin(); itr != claimedGatherNodes.end();)
+        itr = (itr->second == botGuid) ? claimedGatherNodes.erase(itr) : std::next(itr);
+}
+
 // Loot ids of chest-type objects whose every loot row requires a quest. Filled once at startup by
 // BotAI::LoadGatherLootData -- the split is static data, so there's no reason to re-derive it.
 std::unordered_set<uint32> _questOnlyGameObjectLoot;
@@ -2953,6 +2984,9 @@ public:
         if (IsGatherNodeOnRetryCooldown(_state, go->GetGUID()))
             return false;
 
+        if (IsGatherNodeClaimedByOther(go->GetGUID(), _bot->GetGUID()))
