BotAI.DynamicEncounters.MysteryEncounter.RuneGameObjectEntry = 0
BotAI.DynamicEncounters.MysteryEncounter.SpellVisualId = 0

###################################################################################################
# Bot strength scaling (dungeons and raids)
#
#    Bots play with the gear and the rotation of a bot, which is weaker than a person at the same character. Instead of weakening
#    the creatures, the bots get a configurable help while they are in dungeons and raids. Pets, totems and guardians of a bot count
#    as the bot. The multipliers stack on top of the group scaling of the content scaling module. Scripted lethal mechanics
#    (instant kills, percentage damage, huge scripted hits) are not scaled.
#
#    CoaBots.Scaling.Enable        Switch for everything below. Default 1.
#    CoaBots.Scaling.Dungeons      Apply in 5-player dungeons. Default 1.
#    CoaBots.Scaling.Raids         Apply in raids. Default 1.
#    CoaBots.Scaling.Battlegrounds Apply in battlegrounds and arenas. Default 0.
#    CoaBots.Scaling.World         Apply in the open world. Default 0.
#    CoaBots.Scaling.DamageDone    Damage a bot deals to creatures (1 = unchanged). Default 1, range 0.1 to 10.
#    CoaBots.Scaling.HealingDone   Healing a bot casts (1 = unchanged). Default 1, range 0.1 to 10.
#    CoaBots.Scaling.DamageTaken   Damage creatures deal to a bot (below 1 = bots take less). Default 1, range 0.1 to 10.
#    CoaBots.Scaling.TankThreat    Threat a bot tank generates (1 = unchanged). Default 1, range 1 to 10.
#    CoaBots.Scaling.BossTuning    Extra multipliers for a few Wrath bosses that level 60 bots could not beat otherwise (Loken, Drakkari
#                                  Elemental, Colossus and Gal'darah). Default 0.
#
#    Reloadable with .reload config (takes effect within a few seconds).
###################################################################################################

CoaBots.Scaling.Enable = 1
CoaBots.Scaling.Dungeons = 1
CoaBots.Scaling.Raids = 1
CoaBots.Scaling.Battlegrounds = 0
CoaBots.Scaling.World = 0
CoaBots.Scaling.DamageDone = 1
CoaBots.Scaling.HealingDone = 1
CoaBots.Scaling.DamageTaken = 1
CoaBots.Scaling.TankThreat = 1
CoaBots.Scaling.BossTuning = 0


###################################################################################################
# Experimental population scheduling. All optimization switches stay off until runtime qualification.
# Metrics include pooled histogram bins in microseconds; scopes are inclusive, not additive.
CoaBots.Perf.Enable = 0
CoaBots.Perf.Detailed = 1
CoaBots.Perf.ProfileCombat = 0
World.Performance.EntitySampleRate = 0
World.Performance.DirectRankLookup = 0
World.Performance.InterleaveWorldObjects = 0
World.Performance.FilterSpellCandidates = 0
CoaBots.Perf.OutputDir = "bot-performance"

CoaBots.Spells.OptimizeRankLookup = 0
CoaBots.Spells.LazyCleanseScan = 0
CoaBots.Spells.CacheLearnedRanks = 0
CoaBots.Scheduling.Enable = 0
CoaBots.Scheduling.Adaptive = 0
CoaBots.Scheduling.IdleIntervalMs = 200
CoaBots.Scheduling.SoloIntervalMs = 500
CoaBots.Scheduling.FarIdleIntervalMs = 0
CoaBots.Scheduling.DamageWake = 1

# Admission budgets for background work, in microseconds per world update.
# Combat and avoidance are never deferred. A single operation may exceed its budget.
CoaBots.Budgets.Enable = 0
CoaBots.Budgets.PlannerUs = 3000
CoaBots.Budgets.ScanUs = 2000
CoaBots.Budgets.NavigationUs = 4000


CoaBots.Navigation.ReuseValidatedPath = 0
