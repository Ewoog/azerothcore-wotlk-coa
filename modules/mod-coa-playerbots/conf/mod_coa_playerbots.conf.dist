#
# mod-coa-playerbots
#

[worldserver]

# Allow bots to open corpses and take items and money while in a party or raid.
# Disabled by default so grouped players can loot themselves. Solo bots still loot.
# Does not change Need/Greed rolls (see CoaBots.Loot.NeedOnUpgrades) or gathering and fishing loot.
CoaBots.Loot.AutoLootInGroup = 0

# Bots roll Need on group-loot armor and weapons that are an upgrade for them: gear they can equip now,
# that matches their gear preference, and that scores at least 5% better than what they wear in that
# slot (an empty slot always counts). Everything else is Greed, or Pass for armor/weapon types they
# cannot wear or do not prefer. 0 = never Need (Greed/Pass only, the old behavior).
CoaBots.Loot.NeedOnUpgrades = 1

#
#    CoaBots.Enable
#        Description: The master switch of the companions. 0 = no bot is ever logged in (no spawn commands, no login at
#                     start, no group / battleground / dungeon fill). The Manager's Modules page switches this setting.
#                     Bots that are already online stay until the world server restarts.
#        Default:     1 - (Enabled)
#

CoaBots.Enable = 1

#
#    CoaBots.CustomRaces.Enable
#        Description: Allow companion bots to use custom races only when both
#                     CoACustomRaces.Enable and CoACustomRaces.BotsEnable are enabled.
#                     Set to 0 to restrict companions to stock races independently.
#                     Both AiPlayerbot.ExcludedBotRaces and CoaBots.ExcludedBotRaces apply.
#        Default:     1 - (Follows the custom races module permissions)
#

CoaBots.CustomRaces.Enable = 1



# Number of bots '.botcmd spawnrandom' creates when no count is given on the command line.
CoaBots.RandomSpawn.DefaultCount = 10

# Safety cap: a single '.botcmd spawnrandom <count>' invocation never creates more than this
# many bots at once, regardless of what's requested. Each bot is a synchronous DB clone of an
# existing level-80 test character, so a very large batch will cause a visible tick hitch --
# raise this only on a dev/test realm with nobody else online.
CoaBots.RandomSpawn.MaxCount = 1000

# If enabled, each newly created bot is immediately logged in (queued through the same
# null-socket login path '.botcmd spawnbot' uses) instead of only existing in the database
# until spawned by guid later.
CoaBots.RandomSpawn.AutoLogin = 1

# How many bots '.botcmd spawnrandom'/'.botcmd spawnleveled' create per batch, and how many
# milliseconds to wait between batches. Confirmed live: creating ~1000 bots synchronously
# crashed the worldserver outright (no crash dump -- consistent with an OS-level kill under a
# resource spike). The defaults (5 bots every 500ms = 10/sec) survived a live 1000-1500 bot
# batch with no crash; lower BatchSize or raise BatchIntervalMs further on weaker hardware.
CoaBots.RandomSpawn.BatchSize = 5
CoaBots.RandomSpawn.BatchIntervalMs = 500

# Username prefix for the accounts random bots are spread across (auto-created as needed, one
# new account whenever the current one hits CharactersPerAccount). Never account 1 (the human
# player's own account) or account 2 if it's the hand-made test-character account -- new
# accounts are always created fresh under this prefix.
CoaBots.RandomSpawn.AccountPrefix = "CoaBotHost"

# If enabled, every bot character that already exists (any account matching
CoaBots.AutoLoginOnStartup = 0
CoaBots.AutoLogin.MaxCount = 800

# Batch size / interval for CoaBots.AutoLoginOnStartup's gradual login. Login is much lighter
# than character creation (just an async DB query per bot), so this can safely run faster than
# CoaBots.RandomSpawn's batch pace -- default is 10 bots every 500ms (20/sec).
CoaBots.AutoLogin.BatchSize = 10
CoaBots.AutoLogin.BatchIntervalMs = 500

# Human-like solo behavior: a bot has a persistent profile and keeps one intent instead of
# retrying a fixed quest/gather/fish/grind sequence on every idle tick. Values are milliseconds.
CoaBots.Profile.IntentMinMs = 900000
CoaBots.Profile.IntentMaxMs = 2100000

# When enabled, the moment anyone (real player or bot) joins a normal (non-arena, non-rated)
# Battleground queue, both factions' queues for that bracket are automatically topped off with
# bots so the match is always full and pops immediately.
CoaBots.BGFill.Enable = 1

# How many bots per team to top a queue off to. 0 = use the battleground's own real
# max-players-per-team (a genuinely full match); lower it to test with a smaller population.
CoaBots.BGFill.TargetPlayersPerTeam = 0

# When enabled, a solo player queuing for a dungeon (not raid) via the Dungeon Finder is
# automatically joined by bots for whichever of Tank/Healer/3x Damage their own role selection
# doesn't already cover, so a full 5-man is ready immediately. Group joins and raids are out of
# scope -- see BotLfgFill.cpp's header comment.
CoaBots.LfgFill.Enable = 1

# When enabled, an idle Tank-role bot with no group occasionally self-queues for a random
# level-appropriate dungeon via the real Dungeon Finder (LFGMgr) -- CoaBots.LfgFill.Enable's
# existing fill logic then rounds out Healer + 3x Damage automatically, same as it does for a
# real player's solo queue. New and unproven: heavily logged under "AutoQueueDungeon:" (entry
# check, legitimate-clear check via the same real encounter-completion tracking AutoDungeon mode
# itself uses, exit, and auto-disband once every member is confirmed to be a bot) so behaviour
# can be audited from Server.log before trusting it unattended. Off by default.
CoaBots.AutoQueueDungeon.Enable = 0

# Path to the community talent-build data (see reference/ascensionsidekick-level-builds.json in
# the module's own repo, sourced from ascensionsidekick.com) that bots use to spend real talent
# points as they level. Leave blank to use the built-in search (checks this path relative to the
# working directory, one level up, two levels up, and a hardcoded dev-machine path as a last
# resort) -- only set this if the file lives somewhere none of those find it.
CoaBots.TalentBuildsPath = ""

# Bots below level 10 have no specialization yet. Once a bot hits level 10 without one, it's
# assigned a spec from the community build data, weighted toward whichever role (Tank/Healer)
# the current online bot population is short of relative to these target percentages; DPS is
# always the fallback. Raise TankTargetPct/HealerTargetPct if dungeon/raid groups keep running
# short on tanks or healers.
CoaBots.SpecBalance.TankTargetPct = 20
CoaBots.SpecBalance.HealerTargetPct = 20

# How low a heal target's health can drop (percent) before a healer bot breaks formation /
# stops following to cast a heal, even with nothing else going on (no active group fight). Below
# this, the heal always happens; above it, a healer keeps following the group and only heals
# incidentally while doing so. Raise this if healers feel too passive about topping people off;
# lower it if they break formation too often for trivial chip damage.
CoaBots.Healer.CriticalHealPct = 50

# How far (yards) a solo/ungrouped bot with nothing else to do will scan for a hostile to grind
# on, and how many levels above its own level a target can be before it's skipped as too
# dangerous. Lower SearchRadius if idle bots are grinding mobs uncomfortably far from where you'd
# expect to find them; lower MaxLevelAbove if they're picking fights they shouldn't win.
CoaBots.Grind.SearchRadius = 30
CoaBots.Grind.MaxLevelAbove = 3

# Ambient world behavior (src/world/BotWorldBehavior.cpp): gives an idle, ungrouped bot a concrete
# errand -- town services, a trip to a gathering or grinding area, or a short wander -- once its own
# quest/gather/fish/grind scans have found nothing nearby. Never runs for grouped bots, under Stay,
# in battlegrounds or dungeons, or during combat.
CoaBots.World.Enable = 1

# How often each bot re-evaluates its errand. Bots are staggered across this interval so a large
# population never thinks on the same tick.
CoaBots.World.ThinkIntervalMs = 2000

# Outside cities, how long the solo scans must keep coming up empty before an errand starts.
CoaBots.World.IdleBeforeErrandMs = 10000

# Search radius (yards) for service NPCs and mailboxes, and for gathering/grinding destinations.
CoaBots.World.ServiceRadius = 200
CoaBots.World.AreaRadius = 350

# Log every errand transition (chose / arrived / completed / expired / resumed) to the
# module.coa-playerbots.world log category. Useful while tuning, noisy with thousands of bots.
CoaBots.World.VerboseLog = 1

# Level distribution for `.botcmd spawnleveled`: comma-separated "low-high:weight" brackets.
# The default gives many levelling bots and few at the cap: 40% 1-20, 33% 21-60, 20% 61-79, 7% 80.
CoaBots.LeveledSpawn.Brackets = "1-20:40,21-60:33,61-79:20,80-80:7"

###################################################################################################
# Open-world brain (src/world/WorldBrain.h): quests, travel and activity choice for ungrouped bots.
#
# The brain owns an idle, ungrouped bot: it plans a task by utility (quest objectives, turn-ins,
# new quests from nearby givers, a new quest hub), executes it phase by phase (travel, live-target
# search, approach, act, loot, verify) and hands fights to the combat engine. Gathering, fishing,
# grinding and ambient errands only run when the brain chooses them.
#
# Debugging: `.botcmd brain <guid>` (one bot), `.botcmd worldstats` (population). Transition logs
# (TaskSelected, PhaseChanged, TargetSelected, ObjectiveProgress, QuestTurnedIn, TaskFailed,
# navigation stalls) are DEBUG-level on these categories -- enable them in worldserver.conf with e.g.
#   Logger.module.coa-playerbots.world=5,Console Server
#   Logger.module.coa-playerbots.quest=5,Console Server
#   Logger.module.coa-playerbots.navigation=5,Console Server
###################################################################################################

# Master switch. Disabled, bots only gather/fish/grind/wander (no quests at all).
CoaBots.WorldBrain.Enable = 1

# Planner cadence window (ms). Each bot draws its own interval inside it; a planner pass that finds
# nothing backs off exponentially (up to 3 minutes) while the bot does something else.
CoaBots.WorldBrain.PlannerMinMs = 2000
CoaBots.WorldBrain.PlannerMaxMs = 8000

# Live target scan cadence while searching an objective area (ms), and the scan radius (yards).
CoaBots.WorldBrain.ScanMinMs = 500
CoaBots.WorldBrain.ScanMaxMs = 1500
CoaBots.WorldBrain.SearchRadius = 50

# Distance (yards) at which a bot engages a claimed quest mob; the combat engine then positions.
CoaBots.WorldBrain.EngageRange = 28

# Phase budgets (ms): searching an area with nothing alive before trying another area, walking up to
# a claimed target, the whole trip to an area.
CoaBots.WorldBrain.SearchTimeoutMs = 35000
CoaBots.WorldBrain.ApproachTimeoutMs = 25000
CoaBots.WorldBrain.TravelTimeoutMs = 360000

# Quest log policy: at most this many quests at once; quests whose objectives are farther than this
# (yards) are not taken; quest givers are looked for within this radius (yards).
CoaBots.WorldBrain.MaxActiveQuests = 15
CoaBots.WorldBrain.MaxObjectiveDistance = 3000
CoaBots.WorldBrain.GiverSearchRadius = 500

# Quest level window around the bot's level, and how far above its level a quest mob may be.
CoaBots.WorldBrain.QuestLevelBelow = 6
CoaBots.WorldBrain.QuestLevelAbove = 3
CoaBots.WorldBrain.MaxMobLevelAbove = 3

# Solo bots leave elite quests alone unless this is enabled.
CoaBots.WorldBrain.AcceptEliteQuests = 0

# Objective areas given up per objective before the quest is set aside, and for how long (ms).
# A quest that keeps failing for transient reasons (no targets, paths, deaths) is set aside for
# QuestSuspendMs, doubling each time in a row up to QuestSuspendMaxMs, and retried -- never
# abandoned. Only quests that can never be finished (no handler for an open objective, player
# kills, reputation, no ender, failed) are abandoned, and only when the log is full.
CoaBots.WorldBrain.MaxBadAreasPerObjective = 3
CoaBots.WorldBrain.QuestSuspendMs = 600000
CoaBots.WorldBrain.QuestSuspendMaxMs = 7200000

# Mounting for travel: each bot mounts beyond its own threshold drawn from this range (yards).
# Trips longer than TaxiMinDistance (yards) use a flight path when the bot knows a route.
CoaBots.WorldBrain.MountDistanceMin = 60
CoaBots.WorldBrain.MountDistanceMax = 95
CoaBots.WorldBrain.TaxiMinDistance = 900

# Human rhythm: stretches of questing (20-45 minutes, scaled by patience) followed by a few minutes
# of town life; herbalists/miners stepping off the path for a node next to it.
CoaBots.WorldBrain.SessionBreaks = 1
CoaBots.WorldBrain.GatherDetours = 1

# Cooperation: a bot passing by steps into a fight a friendly player (bot or real) is losing --
# only against a mob that player has tagged, so loot, credit and experience stay theirs -- and
# resurrects friendly corpses if it knows a resurrection spell. Sociability decides how often.
CoaBots.WorldBrain.HelpOthers = 1
CoaBots.WorldBrain.HelpRadius = 30
CoaBots.WorldBrain.HelpHealthPct = 40
CoaBots.WorldBrain.ResurrectOthers = 1

# Temporary bot-only parties: sociable bots of about the same level with the same kill quest open
# team up for one objective area or PartyMinMinutes-PartyMaxMinutes, then go their own ways.
# Off by default until watched on a live server. Never used in cluster mode.
CoaBots.WorldBrain.TemporaryParties = 0
CoaBots.WorldBrain.PartyMaxSize = 3
CoaBots.WorldBrain.PartyRadius = 60
CoaBots.WorldBrain.PartyMinMinutes = 5
CoaBots.WorldBrain.PartyMaxMinutes = 20

# Utility weights (see src/world/WorldUtility.h for all of them and what they mean).
CoaBots.WorldBrain.Weight.TravelPer100Yards = 7
CoaBots.WorldBrain.Weight.CrowdPerBot = 6
CoaBots.WorldBrain.Weight.Overlap = 35
CoaBots.WorldBrain.Weight.TurnIn = 120
CoaBots.WorldBrain.Weight.Accept = 55
CoaBots.WorldBrain.Weight.AreaOccupancy = 12
CoaBots.WorldBrain.Weight.TargetReserved = 200
CoaBots.WorldBrain.Weight.ActiveQuestHysteresis = 18
CoaBots.WorldBrain.Weight.CurrentAreaHysteresis = 15

#
#    CoaBots.AI.CombatIntervalMs
#        Description: How often (ms) a bot that is fighting, in a group or in a battleground makes a decision.
#                     Lower is more responsive and costs more world-thread time.
#        Default:     100
#
#    CoaBots.AI.IdleIntervalMs
#        Description: How often (ms) a bot that is on its own and not fighting makes a decision. With hundreds of
#                     bots this is what keeps the world loop fast. 0 = every tick.
#        Default:     250
#

CoaBots.AI.CombatIntervalMs = 100
CoaBots.AI.IdleIntervalMs = 250

#
#    CoaBots.Trade.Enable
#        Description: Bots take part in trades. Open a trade window with a bot, put items or gold in it and accept;
#                     the bot accepts too and keeps what you gave it (it equips anything better than its own gear).
#                     A bot never offers anything of its own. A window nobody confirms is closed after two minutes.
#        Default:     1
#

CoaBots.Trade.Enable = 1

#
# INVENTORY
#
#    CoaBots.Inventory.SellWhenNearVendor
#        Description: When a bot is grouped with a real player and a vendor is within 20 yards,
#                     sell grey junk and outgrown white/green gear even if the bags are not nearly
#                     full. Solo bots still wait until they have two free slots or fewer. 0 keeps
#                     the old "only when nearly full" gate for grouped bots too.
#        Default:     1
#
#    CoaBots.Inventory.SellOnLeaderVendor
#        Description: When a real player in the group opens a vendor (or gossip on a vendor NPC),
#                     grouped bots within CoaBots.Maintenance.ShareRange of that player clear their
#                     bags: grey junk, outgrown or unusable gear, leftover quest items, white vendor
#                     trash, known recipes and surplus trade goods and consumables are sold, and each
#                     item sold is listed in chat. Quest items still needed, possible upgrades,
#                     crafting-order and gather-order items and protected items stay. With the live
#                     economy (CoaBots.Economy.DryRun = 0) what the economy plans for the auction
#                     house is listed there first (CoaBots.Economy.ListFromAnywhere) instead of
#                     sold. 0 turns the hook off; SellWhenNearVendor still applies on the regular
#                     10-second scan.
#        Default:     1
#
#    CoaBots.Inventory.KeepQuality
#        Description: Gear of this quality or better (3 = rare/blue) is not sold as "outgrown"
#                     unless the bot has FreeSlotTarget free general bag slots or fewer. Greys
#                     are always sold. 0 = Poor, 1 = Common, 2 = Uncommon, 3 = Rare, 4 = Epic.
#        Default:     3
#
#    CoaBots.Inventory.CleanupEnable
#        Description: Bots keep free bag space without the economy module. When general-purpose
#                     bag slots drop below FreeSlotTarget, they sell grey junk, outgrown gear,
#                     leftover quest items, excess trade goods and unused consumables (and
#                     destroy unsellable leftover quest items and greys if no vendor is nearby).
#                     Ungrouped bots travel to a vendor when their bags are nearly full (the
#                     same trip also repairs and restocks ammo). Grouped bots sell when you
#                     open a vendor. 0 turns this off.
#        Default:     1
#
#    CoaBots.Inventory.FreeSlotTarget
#        Description: Start cleanup (and a sell trip, for ungrouped bots) when the backpack and
#                     general-purpose bags have fewer free slots than this. Quiver and
#                     profession-bag slots are not counted.
#        Default:     4
#
#    CoaBots.Inventory.TradeGoodsKeep
#        Description: How many of each trade-good item a bot keeps. Anything above this is sold
#                     when bags are nearly full. Materials for an active gather order, and items
#                     on the economy protect list, are never sold.
#        Default:     20
#
#    CoaBots.Inventory.EnsureBags
#        Description: Fill empty bag slots with a level-appropriate general-purpose bag, and
#                     replace a smaller equipped bag with a larger granted one: Small Brown
#                     Pouch (6) under 10, Brown Leather Satchel (8) at 10, Heavy Brown Bag (10)
#                     at 20, Mageweave Bag (12) at 35, Runecloth Bag (14) at 50, Netherweave
#                     Bag (16) at 60. These item ids are in the CoA item_template. 0 turns this
#                     off.
#        Default:     1
#
#    CoaBots.Inventory.BuyBags
#        Description: When a bot is at a vendor (you opened one, or an ungrouped bot arrived
#                     on a sell/repair/ammo trip), buy a larger general-purpose bag that vendor
#                     sells if the bot can afford it after BagBuyReserveCopper. 0 turns this off.
#        Default:     1
#
#    CoaBots.Inventory.BagBuyReserveCopper
#        Description: Copper the bot will not spend when buying a bag (10000 = 1 gold).
#        Default:     10000
#

CoaBots.Inventory.SellWhenNearVendor = 1
CoaBots.Inventory.SellOnLeaderVendor = 1
CoaBots.Inventory.KeepQuality = 3
CoaBots.Inventory.CleanupEnable = 1
CoaBots.Inventory.FreeSlotTarget = 4
CoaBots.Inventory.TradeGoodsKeep = 20
CoaBots.Inventory.EnsureBags = 1
CoaBots.Inventory.BuyBags = 1
CoaBots.Inventory.BagBuyReserveCopper = 10000

#
# REPAIR AND AMMO
#
#    CoaBots.Maintenance.RepairOnLeaderVendor
#        Description: When a real player in the group talks to a repair-capable NPC, grouped bots
#                     on the same map and within ShareRange repair all of their damaged gear with
#                     their own gold (what they cannot afford is left, and custom items whose
#                     repair cost cannot be looked up are still mended). 0 turns this off.
#        Default:     1
#
#    CoaBots.Maintenance.BuyAmmoOnLeaderVendor
#        Description: When a real player in the group opens a vendor that sells arrows or bullets,
#                     grouped bots on the same map and within ShareRange who have a bow, gun, or
#                     crossbow equipped buy the best ammo that vendor sells which they can use,
#                     up to AmmoFill, and equip it. 0 turns this off.
#        Default:     1
#
#    CoaBots.Maintenance.ShareRange
#        Description: How far a grouped bot may be from the commander (same map) to repair or
#                     restock when the commander opens a repairer or ammo vendor, in yards.
#        Default:     80
#
#    CoaBots.Maintenance.AutoTravel
#        Description: Ungrouped bots (including alts working a gather order, and random world
#                     bots) travel to the nearest same-map, same-faction repairer when their
#                     gear is worn, or to a vendor that sells the right ammo when their quiver
#                     is low. The trip pauses a gather order and the order resumes afterwards.
#                     0 leaves only the opportunistic "already standing next to the NPC" path.
#        Default:     1
#
#    CoaBots.Maintenance.TravelSearchYards
#        Description: How far an ungrouped bot looks for a repairer or ammo vendor when AutoTravel
#                     is on, in yards. The search stays on the bot's current map.
#        Default:     30000
#
#    CoaBots.Maintenance.NearbyServiceYards
#        Description: Once the bot has arrived, how far it will look for a live repairer or ammo
#                     vendor around the destination, in yards.
#        Default:     80
#
#    CoaBots.Maintenance.RepairItemPct
#        Description: Start a repair trip (or opportunistic repair) when any equipped piece is
#                     below this percent of its maximum durability.
#        Default:     30
#
#    CoaBots.Maintenance.RepairAveragePct
#        Description: Also start a repair trip when the average durability of all equipped pieces
#                     that have durability is below this percent, even if no single piece is
#                     under RepairItemPct.
#        Default:     50
#
#    CoaBots.Maintenance.AmmoLow
#        Description: Start an ammo trip when a bot with a bow, gun, or crossbow has fewer than
#                     this many matching arrows or bullets in its bags and quiver.
#        Default:     200
#
#    CoaBots.Maintenance.AmmoFill
#        Description: Buy enough ammo to reach this count when restocking (at a vendor the
#                     commander opened, after a trip, or when already standing next to one).
#        Default:     1000
#

CoaBots.Maintenance.RepairOnLeaderVendor = 1
CoaBots.Maintenance.BuyAmmoOnLeaderVendor = 1
CoaBots.Maintenance.ShareRange = 80
CoaBots.Maintenance.AutoTravel = 1
CoaBots.Maintenance.TravelSearchYards = 30000
CoaBots.Maintenance.NearbyServiceYards = 80
CoaBots.Maintenance.RepairItemPct = 30
CoaBots.Maintenance.RepairAveragePct = 50
CoaBots.Maintenance.AmmoLow = 200
CoaBots.Maintenance.AmmoFill = 1000


#
# QUEST SHARING
#
#    CoaBots.Quest.ShareTurnIn
#        Description: When a real player in a group turns in a quest, grouped bots within 40 yards
#                     that also have that quest complete hand it in too. They get the XP and gold
#                     and pick the reward item that is the best upgrade for them (the same scoring
#                     used when a solo bot turns a quest in). A bot that is missing required items,
#                     or cannot take the reward yet, is skipped. 0 turns this off.
#        Default:     1
#
#    CoaBots.Quest.ShareAccept
#        Description: When a real player in a group accepts a quest, grouped bots within 40 yards
#                     also take it if they can (level, race, class, prerequisites, quest log room).
#                     Kill credit is already shared by the group; item-objective drops are not,
#                     so a bot still has to loot those itself. 0 turns this off.
#        Default:     1
#
#    CoaBots.Quest.ShareIgnoreEligibility
#        Description: Your own alts (characters on your account, logged in as companions) take the
#                     quests you accept even when they are not eligible (level, race, class,
#                     prerequisites, reputation, skill). Other bots still need to be eligible. A
#                     quest the alt already turned in, a full quest log or no bag space for the
#                     quest's starting item still stops it. The AltBots "Share quests" button uses
#                     the same rule for the quests already in your log. 0 turns this off.
#        Default:     1
#
#    CoaBots.Quest.ShareObjectLoot
#        Description: When you loot a quest item from an object in the world (a chest, crate or
#                     other quest object), each of your own grouped alts within 80 yards that still
#                     needs that item for a quest gets a copy. Clicking a quest object that gives
#                     objective credit already counts for every group member in range. 0 turns
#                     this off.
#        Default:     1
#

CoaBots.Quest.ShareTurnIn = 1
CoaBots.Quest.ShareAccept = 1
CoaBots.Quest.ShareIgnoreEligibility = 1
CoaBots.Quest.ShareObjectLoot = 1

#
# GATHERING WHILE FOLLOWING
#
#    CoaBots.Gather.WhileFollowing
#        Description: When a bot is following a real player, it will opportunistically gather
#                     herbalism and mining nodes it passes if it has the matching profession
#                     and enough skill for the node (the same lock/skill check a player uses).
#                     The bot must be out of combat, nobody in the group may be in combat, the
#                     leader must be within 40 yards, and the bot must have bag space. It walks
#                     to the node, casts the real gather spell (skill-ups apply normally), loots,
#                     then resumes following. Farm mode skips this so a farm order is not
#                     interrupted. Chests, lockboxes and skinnable corpses are not gathered.
#                     0 turns this off.
#        Default:     1
#
#    CoaBots.Gather.FollowRadius
#        Description: How close a node must be (yards) for a following bot to notice it.
#                     Clamped to 5-40.
#        Default:     20
#

CoaBots.Gather.WhileFollowing = 1
CoaBots.Gather.FollowRadius = 20

#
#    CoaBots.Prof.StartSkill
#        Starting skill value when the addon teaches a bot a profession (SETPROF).
#        0 (default) is level-based: the value is set to the level cap (level * 6,
#        max 450) so gathering and crafting of that tier work immediately.
#        Any other number is used as the starting value, clamped between 1 and the cap.
#        Unlearning a profession always wipes its skill and trainer rank spells.
#
CoaBots.Prof.StartSkill = 0

#
#    CoaBots.Professions.TwoPrimary
#        Description: Fresh random bots (and a legacy reroll) receive two primary professions
#                     plus Cooking, First Aid and Fishing, instead of every profession this
#                     realm allows. The pair is weighted and class-biased but seeded by the
#                     character guid, so it does not change on login. SETPROF on a companion
#                     and a player's own account alts are not limited. 0 restores the old
#                     grant-every-profession behaviour.
#        Default:     1
#
#    CoaBots.Professions.GrantSecondaries
#        Description: Also teach Cooking, First Aid and Fishing when assigning a random bot's
#                     professions. 0 leaves secondaries untouched.
#        Default:     1
#
#    CoaBots.Professions.RerollLegacy
#        Description: On login, a bot-account bot that still has the old all-profession set
#                     (ten or more primary professions) is assigned a varied pair once.
#                     Bots marked manual (SETPROF or `.botcmd professiontrainer`) and
#                     characters on a player's own account are left alone.
#                     `.botcmd reroll professions all` / `.botcmd reroll professions <name>`
#                     does the same on demand; `.botcmd profstats` shows the spread.
#        Default:     1
#

CoaBots.Professions.TwoPrimary = 1
CoaBots.Professions.GrantSecondaries = 1
CoaBots.Professions.RerollLegacy = 1

#
#    CoaBots.MarkSessionsAsBots
#        Description: Mark companion sessions as bots, so the server skips per-client work they have no client for
#                     (login queries, view refreshes, reward trackers) and bots are left out of /who (see
#                     WhoList.ShowBots). Turn off only to compare behaviour.
#        Default:     1
#

CoaBots.MarkSessionsAsBots = 1

###################################################################################################
# ECONOMY
###################################################################################################
#
#    CoaBots.Economy.Enable
#        Description: Bots look into their bags and write down what they would sell and what it would
#                     fetch (see `.botcmd economy status`, `plan <bot guid>`, `journal`). Nothing is
#                     sold while CoaBots.Economy.DryRun = 1, so the rules can be checked before bots trade.
#        Default:     0
#
#    CoaBots.Economy.MinTripCopper
#        Description: A bot is only noted down when what it could sell is worth at least this much.
#        Default:     50000 - (5 gold)
#
#    CoaBots.Economy.KeepConsumables
#        Description: How many potions / food items of its own level range a bot keeps of each kind.
#        Default:     10
#
#    CoaBots.Economy.OutdatedBelowLevels
#        Description: A potion or food this many levels below the bot counts as outdated and is
#                     planned for sale in full.
#        Default:     15
#
#    CoaBots.Economy.MinAuctionQuality
#        Description: Items of this quality (2 = uncommon) and better are planned for the auction when
#                     they can be listed, everything else for a vendor.
#        Default:     2
#
#    CoaBots.Economy.UndercutPercent
#        Description: How far below the lowest current buyout the plan prices an item.
#        Default:     5
#
#    CoaBots.Economy.ScanIntervalSec / BotsPerTick / JournalDays
#        Description: How often one bot is looked at, how many bots per world tick, and how long
#                     journal rows are kept.
#        Default:     300 / 2 / 14
#

#
#    CoaBots.Economy.DryRun
#        Description: 1 = bots only plan and journal. 0 = bots really go to a city with an auction house (on
#                     foot, by flight path, mounted), list what the plan says for the auction, sell the rest
#                     to a vendor price, collect what earlier auctions earned, and pay the guild its share.
#        Default:     1
#
#    CoaBots.Economy.MaxTrips
#        Description: How many bots may be on their way to town at the same moment.
#        Default:     15
#
#    CoaBots.Economy.TripCooldownMin
#        Description: Minutes before the same bot is sent to town again.
#        Default:     30
#
#    CoaBots.Economy.GuildSharePercent
#        Description: Percent of what a trip earns that goes into the bot's guild bank.
#        Default:     10
#
#    CoaBots.Economy.MoneyReserveCopper
#        Description: A bot keeps at least this much money for its own needs when it pays the guild.
#        Default:     50000 - (5 gold)
#
#    CoaBots.Economy.MaxListings
#        Description: How many auctions one bot may have running. When a bot has this many running, the rest of its
#                     auction finds wait in its bags for the next listing instead of going to a vendor.
#        Default:     40
#
#    CoaBots.Economy.ConsumeSupplies
#        Description: 1 = eating and drinking cost something. A bot that sits down to eat or drink uses up one food or
#                     drink item of its level range; with none it rests the slow way and wants a trip to town, where
#                     it buys more with its own money (the best food and drink it may use, up to SupplyTarget of each,
#                     within DailyBudgetCopper a day and keeping MoneyReserveCopper). Needs CoaBots.Economy.Enable = 1.
#                     0 = bots rest with the instant food and drink effect and no items, as before.
#        Default:     0
#
#    CoaBots.Economy.SupplyTarget / DailyBudgetCopper
#        Description: How many food and how many drink items a bot likes to carry; what one bot may spend on them in
#                     a day.
#        Default:     20 / 20000 - (2 gold)
#
#    Stock limits (no setting)
#        Description: The guild master and officers set limits from the addon's Stock tab ("keep N of this resource").
#                     Once a minute a free bot of the guild takes a surplus (above the limit and at least 10, or a tenth
#                     of the limit) out of the guild bank, carries it to a city with an auction house and sells it. One
#                     surplus run per guild at a time. Needs CoaBots.Economy.Enable = 1 and DryRun = 0.
#
#    CoaBots.Economy.MinListingCopper / ListingMinutes
#        Description: A listing worth less than this is not worth its deposit and goes to a vendor instead; how
#                     long a listing runs (12 hours = 720, 24 hours = 1440, 48 hours = 2880).
#        Default:     1000 (10 silver) / 2880
#
#    CoaBots.Economy.PriceSpreadMinPercent / PriceSpreadMaxPercent
#        Description: Listing prices differ from the plan's price by a random 5 to 10 percent, up or down,
#                     so the market looks alive.
#        Default:     5 / 10
#
#    CoaBots.Economy.AuctionBuyGear
#        Description: 1 = bots buy gear upgrades for their spec at the auction house: on every trip to an auction
#                     house, and on a shopping trip of their own when they have ShoppingMinSpareCopper to spare and
#                     an upgrade is on offer. An upgrade must score AuctionBuyMinUpgradePercent better than the piece
#                     the bot wears. Needs CoaBots.Economy.Enable = 1 and DryRun = 0. `.botcmd economy shop <bot guid>`
#                     shows what a bot would buy.
#        Default:     0
#
#    CoaBots.Economy.AuctionBuyBudgetPercent / AuctionBuyMaxItems / AuctionBuyMinUpgradePercent
#        Description: Percent of the money above MoneyReserveCopper a bot may spend on one visit; upgrades bought on
#                     one visit; how much better than the worn piece an upgrade has to be.
#        Default:     25 / 2 / 10
#
#    CoaBots.Economy.AuctionBuyFromBots
#        Description: 1 = bots may buy other bots' listings too. 0 = only players' listings.
#        Default:     1
#
#    CoaBots.Economy.ShoppingMinSpareCopper / ShoppingIntervalMin
#        Description: Money above the reserve a bot needs before it goes shopping with nothing to sell; minutes
#                     between two looks for upgrades by the same bot.
#        Default:     200000 - (20 gold) / 120
#
#    CoaBots.Economy.AuctionBuyHourlyCapCopper
#        Description: What all bots together may spend at the auction houses in one hour (gear and crafting
#                     reagents). Keeps a large bot population from emptying the auction houses. 0 = no cap.
#        Default:     5000000 - (500 gold)
#
#    CoaBots.Economy.AuctionBuyMaxVendorMultiple
#        Description: A bot never pays more per item than this many times the item's vendor sell price (items a
#                     vendor buys for nothing have no ceiling). 0 = no ceiling.
#        Default:     20
#
#    CoaBots.Economy.ListFromAnywhere
#        Description: 1 = every time a bot is looked at (ScanIntervalSec) it collects its auction mail and lists its
#                     auction finds at its own side's auction house from wherever it is, without a trip to town. Fills
#                     the auction house far faster than trips alone. Needs Enable = 1 and DryRun = 0.
#        Default:     0
#
#    CoaBots.Economy.SellTradeGoods
#        Description: 1 = gathered and looted materials (herbs, ore, leather, cloth, meat, elemental...) are listed at
#                     the auction house instead of sitting in the bags. The guild bank comes first: what an officer's
#                     stock limit still lacks is paid in before the rest is listed. A bot on a guild gather order sells
#                     no materials, and crafting-order reagents and protected items are never sold.
#        Default:     0
#
#    CoaBots.Economy.TradeGoodsKeep
#        Description: How many of each material a bot keeps for itself when SellTradeGoods = 1.
#        Default:     0
#
#    CoaBots.Economy.EstimateMultiplier
#        Description: An item nobody lists yet is priced at this many times its vendor price (never below the price
#                     vendors sell it for). Once it is listed, the lowest buyout sets the price.
#        Default:     3
#
#    CoaBots.Economy.CraftForMarket
#        Description: 1 = on every auction house visit a bot crafts goods from its own materials with the recipes it
#                     knows, when the product fetches CraftForMarketMarginPercent more than the materials are worth,
#                     and lists them. Reagents held for a crafting or gather order and protected items are never used.
#                     `.botcmd economy crafts <bot guid>` shows what a bot would craft. Needs Enable = 1 and DryRun = 0.
#        Default:     0
#
#    CoaBots.Economy.CraftForMarketMaxCasts / CraftForMarketMarginPercent
#        Description: Crafts per auction house visit; how much more than its materials a product must fetch.
#        Default:     10 / 25
#

CoaBots.Economy.Enable = 0
CoaBots.Economy.MinTripCopper = 50000
CoaBots.Economy.KeepConsumables = 10
CoaBots.Economy.OutdatedBelowLevels = 15
CoaBots.Economy.MinAuctionQuality = 2
CoaBots.Economy.UndercutPercent = 5
CoaBots.Economy.ScanIntervalSec = 300
CoaBots.Economy.BotsPerTick = 2
CoaBots.Economy.JournalDays = 14
CoaBots.Economy.DryRun = 1
CoaBots.Economy.MaxTrips = 15
CoaBots.Economy.TripCooldownMin = 30
CoaBots.Economy.GuildSharePercent = 10
CoaBots.Economy.MoneyReserveCopper = 50000
CoaBots.Economy.MaxListings = 40
CoaBots.Economy.ConsumeSupplies = 0
CoaBots.Economy.SupplyTarget = 20
CoaBots.Economy.DailyBudgetCopper = 20000
CoaBots.Economy.MinListingCopper = 1000
CoaBots.Economy.ListingMinutes = 2880
CoaBots.Economy.PriceSpreadMinPercent = 5
CoaBots.Economy.PriceSpreadMaxPercent = 10
CoaBots.Economy.AuctionBuyGear = 0
CoaBots.Economy.AuctionBuyBudgetPercent = 25
CoaBots.Economy.AuctionBuyMaxItems = 2
CoaBots.Economy.AuctionBuyMinUpgradePercent = 10
CoaBots.Economy.AuctionBuyFromBots = 1
CoaBots.Economy.ShoppingMinSpareCopper = 200000
CoaBots.Economy.ShoppingIntervalMin = 120
CoaBots.Economy.AuctionBuyHourlyCapCopper = 5000000
CoaBots.Economy.AuctionBuyMaxVendorMultiple = 20
CoaBots.Economy.ListFromAnywhere = 0
CoaBots.Economy.SellTradeGoods = 0
CoaBots.Economy.TradeGoodsKeep = 0
CoaBots.Economy.EstimateMultiplier = 3
CoaBots.Economy.CraftForMarket = 0
CoaBots.Economy.CraftForMarketMaxCasts = 10
CoaBots.Economy.CraftForMarketMarginPercent = 25

###################################################################################################
# CRAFTING ORDERS
###################################################################################################
#
#    CoaBots.Crafting.ReagentsFromGuildBank
#        Description: 1 = a bot on a crafting order takes the reagents it is missing out of its guild bank.
#        Default:     0
#
#    CoaBots.Crafting.ReagentsFromVendor
#        Description: 1 = it buys missing reagents that vendors sell for gold (thread, flux, vials, dyes...) with its
#                     own money, keeping CoaBots.Economy.MoneyReserveCopper.
#        Default:     0
#
#    CoaBots.Crafting.ReagentsFromAuction
#        Description: 1 = it buys the rest at its side's auction house, cheapest per item first. Needs
#                     CoaBots.Economy.Enable = 1 and DryRun = 0.
#        Default:     0
#
#    CoaBots.Crafting.ReagentBudgetCopper
#        Description: What one crafting order may spend on reagents in all.
#        Default:     100000 - (10 gold)
#
#    CoaBots.Crafting.OrderTimeoutMin
#        Description: A crafting order still short of reagents after this many minutes is given up, and the
#                     requester is told what was missing. Reagents the requester mails to the crafter are taken
#                     out of its mailbox while it waits. 0 = wait forever.
#        Default:     120
#
#    CoaBots.Crafting.MaxCastFailures
#        Description: A crafting order whose cast fails this many times in a row (no tool, not at an anvil or forge,
#                     skill too low, bags full) is given up and the requester is told why. Failed casts are retried
#                     every 5 seconds instead of every tick. 0 = keep trying.
#        Default:     10
#

CoaBots.Crafting.ReagentsFromGuildBank = 0
CoaBots.Crafting.ReagentsFromVendor = 0
CoaBots.Crafting.ReagentsFromAuction = 0
CoaBots.Crafting.ReagentBudgetCopper = 100000
CoaBots.Crafting.OrderTimeoutMin = 120
CoaBots.Crafting.MaxCastFailures = 10

###################################################################################################
# COMBAT INTELLIGENCE
###################################################################################################
#
#    CoaBots.Combat.BurstPrediction
#        Description: A damaging cast aimed at a bot (a tankbuster on its cast bar) makes the bot spend
#                     a defensive cooldown, and its healers pre-heal, before the hit lands. The damage
#                     counted is what reaches health after the shields that are still up when it lands.
#        Default:     1
#
#    CoaBots.Combat.BurstPctThreshold
#        Description: A predicted hit of at least this share of the bot's maximum health counts as a burst.
#        Default:     25
#
#    CoaBots.Combat.GroupInterruptDirector
#        Description: EXPERIMENTAL. Grouped bots interrupt what the group assigns them (one primary and one backup
#                     per enemy cast, backup takes over at once when the primary cannot act). 0 keeps the rule where
#                     every bot kicks the cast of its own target. Off because in the INTERRUPT_MULTI test it applied
#                     about half as many interrupts as the own-target rule (its reaction delay is long for 1.5 s casts),
#                     see docs/combat-intelligence/POST_REVIEW_HARDENING.md.
#        Default:     0
#

CoaBots.Combat.BurstPrediction = 1
CoaBots.Combat.BurstPctThreshold = 25
CoaBots.Combat.GroupInterruptDirector = 0

CoaBots.Training.Enable = 0
CoaBots.Training.OutputDir = training/results
CoaBots.Training.DefaultLevel = 60
CoaBots.Training.DefaultDurationSec = 180
CoaBots.Training.Deterministic = 1
CoaBots.Training.LogDecisionTrace = 1
CoaBots.Training.BossEntry = 31144

#
#    CoaBots.Training.TargetIsBoss
#        Description: Training only. Treat the training dummy as a boss for the "worth an offensive
#                     cooldown" decision (the dummy is a rank-0 creature, so cooldowns are otherwise
#                     scored x0.15). Changes measurements: do not compare runs across the setting.
#        Default:     0
#

CoaBots.Training.TargetIsBoss = 0

CoaBots.Training.HazardSpellId = 5740
CoaBots.Training.InterruptCastSpellId = 133

#    CoaBots.Training.RealisticDamage
#        Description: Training only. A scripted hit (tankbuster, ramp hit) goes through the same steps as a spell hit
#                     (immunity, armor for physical schools, damage-taken modifiers, resistance, absorbs) for the school of
#                     RealisticDamageSpellId. It never misses, never crits and has no procs or threat. Changes
#                     measurements: do not compare runs across the setting.
#        Default:     0
#
CoaBots.Training.RealisticDamage = 0
CoaBots.Training.RealisticDamageSpellId = 686

#    CoaBots.Training.RealisticDamageLegacyPath
#        Description: Training only. 1 selects the first approximation of RealisticDamage (damage-taken modifiers and absorbs,
#                     then plain DealDamage) instead of the spell-hit steps. Only for runs that must stay comparable with earlier ones.
#        Default:     0
#
CoaBots.Training.RealisticDamageLegacyPath = 0

# Reserved training phases: bits 30..27; configure only on isolated servers.
CoaBots.Training.MaxParallelArenas = 1

# Outland (map 530) and Northrend (map 571) for bots. 2 = automatic: closed when MaxPlayerLevel is 60 or lower and the
# content scaling that brings those expansions down to that range is off (CoAContentScaling.Enable, with CoATBC.Enable
# for Outland and CoAWotLK.Enable for Northrend). 1 = always closed, 0 = always open. A closed map means: no
# spawns, no hubs, no quests, no flights there, and bots found there are moved out. The starting areas of the
# Blood Elves (Eversong, Ghostlands, Silvermoon) and the Draenei (Azuremyst, Bloodmyst, the Exodar) stay open.
CoaBots.RestrictExpansionZones = 2

###################################################################################################
# DYNAMIC BOT ENCOUNTERS (WorldEncounterDirector)
#
#    BotAI.DynamicEncounters.Enable
#        Description: Master toggle for open-world dynamic bot encounters (WorldEncounterDirector).
#                     Encounters temporarily borrow existing open-world playerbots to stage rare
#                     ambient, PvP, or atmospheric events, returning bots to WorldBrain afterward.
#        Default:     1
#
#    BotAI.DynamicEncounters.<Type>.Enable
#        Description: Per-encounter enable flags for all 13 encounter types.
#        Default:     1
#
#    BotAI.DynamicEncounters.MaxGlobalActive / MaxActivePerMap / MaxActiveNearPlayer
#        Description: Global, per-map, and per-real-player active encounter caps.
#        Default:     12 / 4 / 1
#
#    BotAI.DynamicEncounters.ThinkIntervalMs / RareScanIntervalMs
#        Description: Staggered evaluation cadence for the director and rare creature scans.
#        Default:     5000 / 20000
#
#    BotAI.DynamicEncounters.PlayerCooldownSec / PlayerHostileCooldownSec / BotCooldownSec
#        Description: Cooldowns (seconds) preventing a real player or bot from being repeatedly
#                     selected for encounters.
#        Default:     900 / 1500 / 600
#
#    BotAI.DynamicEncounters.Narrator.Enable / PlayerCooldownSec / BotCooldownSec
#        Description: Optional atmospheric messages and contextual bot lines (/say, /yell, /emote).
#        Default:     1 / 120 / 45
#
###################################################################################################

BotAI.DynamicEncounters.Enable = 1
BotAI.DynamicEncounters.ThinkIntervalMs = 5000
BotAI.DynamicEncounters.RareHunter.ScanIntervalMs = 20000

BotAI.DynamicEncounters.AssassinContract.Enable = 1
BotAI.DynamicEncounters.TheWatcher.Enable = 1
