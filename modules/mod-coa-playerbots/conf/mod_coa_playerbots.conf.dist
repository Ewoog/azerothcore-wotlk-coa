BotAI.DynamicEncounters.PatrolAmbush.Enable = 1
BotAI.DynamicEncounters.BountyHunter.Enable = 1
BotAI.DynamicEncounters.Nemesis.Enable = 1
BotAI.DynamicEncounters.RoadDuel.Enable = 1
BotAI.DynamicEncounters.Caravan.Enable = 1
BotAI.DynamicEncounters.Deserter.Enable = 1
BotAI.DynamicEncounters.HunterAndPrey.Enable = 1
BotAI.DynamicEncounters.RivalAdventuringParty.Enable = 1
BotAI.DynamicEncounters.RareHunter.Enable = 1
BotAI.DynamicEncounters.MysteryEncounter.Enable = 1

BotAI.DynamicEncounters.MaxGlobalActive = 12
BotAI.DynamicEncounters.MaxMapActive = 4
BotAI.DynamicEncounters.MaxPerPlayerActive = 1

BotAI.DynamicEncounters.PersonalCooldownSec = 900
BotAI.DynamicEncounters.BotCooldownSec = 600
BotAI.DynamicEncounters.TypeCooldownSec = 300

BotAI.DynamicEncounters.MaxLevelDiff = 4
BotAI.DynamicEncounters.AssassinContract.MaxPlayerPartySize = 2
BotAI.DynamicEncounters.SearchRadiusYards = 220
BotAI.DynamicEncounters.MaxChaseDistanceYards = 280
BotAI.DynamicEncounters.MinCityDistanceYards = 180

BotAI.DynamicEncounters.PrepareTimeoutSec = 90
BotAI.DynamicEncounters.ActiveTimeoutSec = 180
BotAI.DynamicEncounters.ResolveTimeoutSec = 20
BotAI.DynamicEncounters.Caravan.TimeoutSec = 300

BotAI.DynamicEncounters.Narrator.Enable = 1
BotAI.DynamicEncounters.Narrator.PlayerCooldownSec = 120
BotAI.DynamicEncounters.Narrator.BotCooldownSec = 45
BotAI.DynamicEncounters.Narrator.MaxDistanceYards = 45

BotAI.DynamicEncounters.BountyHunter.KillScore = 25
BotAI.DynamicEncounters.BountyHunter.Threshold = 75
BotAI.DynamicEncounters.BountyHunter.DecayPerMinute = 2
BotAI.DynamicEncounters.BountyHunter.CooldownSec = 1800

BotAI.DynamicEncounters.Nemesis.TtlSec = 3600
BotAI.DynamicEncounters.Nemesis.DecayIntervalSec = 300
BotAI.DynamicEncounters.Nemesis.MinGrudgeScore = 10

BotAI.DynamicEncounters.Caravan.MinMembers = 2
BotAI.DynamicEncounters.Caravan.MaxMembers = 5
BotAI.DynamicEncounters.FactionSkirmish.MinPerSide = 2
BotAI.DynamicEncounters.FactionSkirmish.MaxPerSide = 4
BotAI.DynamicEncounters.RivalAdventuringParty.MinMembers = 3
BotAI.DynamicEncounters.RivalAdventuringParty.MaxMembers = 5
